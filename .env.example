# Copie para .env e preencha. Nenhum destes valores é commitado (.env está no .gitignore).

# --- Ingestão ---
YOUTUBE_API_KEY=

# --- LLM ---
# LLM_PROVIDER=groq (padrão) ou ollama (local, sem cota)
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Modelo usado só pelo RAG do módulo de Insights (/insights/ask e cards).
# Vazio = usa LLM_MODEL. Útil para um modelo mais barato nas respostas longas.
LLM_INSIGHTS_MODEL=

# --- Auth ---
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Admin bootstrap ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- API ---
# Origens permitidas no CORS (lista separada por vírgula). "*" apenas em desenvolvimento.
CORS_ORIGINS=*
